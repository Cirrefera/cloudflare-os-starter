{
  "name": "gatekeeper-cloudflareaccount",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "allow_irrevocable_stub_storage",
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.txt"
      ],
      "fallthrough": false
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CloudflareAccountConnection",
        "CloudflareAccountGatekeeper"
      ]
    }
  ]
}
