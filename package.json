{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "pnpm --dir cloudflare-os build && pnpm types:generate:custom && vp run --filter=custom-gatekeeper --filter=error-reporter --filter=gatekeeper-snowflake --filter=gatekeeper-huggingface --filter=gatekeeper-cloudflareaccount --filter=gatekeeper-alphaxiv --cache build",
    "test": "pnpm --dir cloudflare-os exec vp run --filter=!cloudflare-os --no-cache test",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run build",
    "check:boundary": "node scripts/boundary-check.ts",
    "check": "pnpm check:boundary && node scripts/deploy.ts --check",
    "deploy": "node scripts/deploy.ts",
    "check:full": "node scripts/deploy.ts --check --config scripts/deployment.full-check.jsonc",
    "types:generate:custom": "pnpm --filter=custom-gatekeeper --filter=error-reporter --filter=gatekeeper-snowflake --filter=gatekeeper-huggingface --filter=gatekeeper-cloudflareaccount --filter=gatekeeper-alphaxiv exec wrangler types --include-env false"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "26.1.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
